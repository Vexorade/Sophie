# Copiar a .env en local. En Render se cargan en el panel "Environment". NUNCA subir valores reales a GitHub.
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://usuario:clave@localhost:5432/sophie
DATABASE_SSL=false

# Panel de administración (pedidos.html). Usuario y clave Basic Auth.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Mercado Pago (Checkout Pro). Dejar vacío para no habilitar cobros.
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_LIVE_ENABLED=false
MERCADO_PAGO_WEBHOOK_SECRET=

# Transferencias bancarias (datos para mostrar al comprador)
SOPHIE_BANK_ACCOUNT=
SOPHIE_BANK_HOLDER=
SOPHIE_BANK_NAME=
